<launch>
  <!-- TurtleBot3 Model -->
  <arg name="model" default="burger"/>
  <env name="TURTLEBOT3_MODEL" value="$(arg model)" />

  <!-- Start Gazebo with empty world -->
  <include file="$(find turtlebot3_gazebo)/launch/turtlebot3_empty_world.launch">
    <arg name="model" value="$(arg model)" />
  </include>

  <!-- Launch robot state publisher -->
  <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher"/>

  <!-- Launch your pose controller -->
  <node pkg="turtle_controller" type="pid_pose_controller.py" name="pose_controller" output="screen" />

  <!-- Node to convert RViz '2D Pose Estimate' to /target_pose -->
  <node pkg="turtle_controller" type="initialpose_to_target.py" name="initialpose_converter" output="screen" />

  <!-- Launch RViz -->
  <node pkg="rviz" type="rviz" name="rviz" args="-d $(find turtle_controller)/rviz/pose_controller.rviz" required="true" />
</launch>
