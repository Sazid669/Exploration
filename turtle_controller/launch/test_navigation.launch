<launch>
  <!-- Set TurtleBot3 model -->
  <arg name="model" default="burger"/>
  <env name="TURTLEBOT3_MODEL" value="$(arg model)" />

  <!-- 1. Gazebo environment -->
  <include file="$(find turtlebot3_gazebo)/launch/turtlebot3_world.launch">
    <arg name="model" value="$(arg model)" />
  </include>

  <!-- 2. SLAM -->
  <include file="$(find turtlebot3_slam)/launch/turtlebot3_slam.launch" />

  <!-- 3. Move Base -->
  <node pkg="move_base" type="move_base" name="move_base" output="screen">
    <param name="base_global_planner" value="navfn/NavfnROS" />
    <param name="base_local_planner" value="dwa_local_planner/DWAPlannerROS" />
    
    <rosparam file="$(find turtle_controller)/config/costmap_common_params_burger.yaml" command="load" ns="global_costmap" />
    <rosparam file="$(find turtle_controller)/config/costmap_common_params_burger.yaml" command="load" ns="local_costmap" />
    <rosparam file="$(find turtle_controller)/config/global_costmap_params_burger.yaml" command="load" />
    <rosparam file="$(find turtle_controller)/config/local_costmap_params_burger.yaml" command="load" />
    <rosparam file="$(find turtle_controller)/config/dwa_local_planner_params_burger.yaml" command="load" />
  </node>

    <!-- 4. RViz to send goals
  <node pkg="rviz" type="rviz" name="nav_rviz" args="-d $(find turtlebot3_navigation)/rviz/turtlebot3_nav.rviz" /> -->

</launch>
